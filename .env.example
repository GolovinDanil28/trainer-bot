# Скопируй в .env и заполни. .env в git не попадает.

# Токен бота из @BotFather. Обязателен.
BOT_TOKEN=

# Твой Telegram user id (узнать: написать @userinfobot). Обязателен.
OWNER_ID=

# Таймзона расписания и отображения времени.
TZ=Asia/Yekaterinburg

# Окно ожидания отметки в часах. Не задано — до конца суток пользователя.
# MISS_WINDOW_HOURS=12

# Строка подключения. По умолчанию файл trainer.db в корне проекта.
# DB_URL=sqlite:///trainer.db
